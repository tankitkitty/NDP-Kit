# การเชื่อมต่อ MySQL ของ HOSxP (ถ้าตั้งค่าที่นี่ จะมีผลเหนือ data/dbconfig.json)
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าให้ตรงเครื่องของหน่วยบริการ
#
# คำแนะนำด้านความปลอดภัย: หน้าตรวจความพร้อมก่อนส่งเคลม (NDP precheck) อ่านข้อมูล
# อย่างเดียว — แนะนำสร้าง MySQL user แบบ SELECT-only ใช้กับแอปนี้ เช่น
#   CREATE USER 'readonly13'@'%' IDENTIFIED BY 'รหัสผ่าน';
#   GRANT SELECT ON hos.* TO 'readonly13'@'%';
# ปุ่ม "รันคำสั่งแก้ไขจากระบบ" จะใช้ไม่ได้กับ user นี้ (ระบบจะแจ้งให้ copy SQL
# ไปรันใน SQL Query ของ HOSxP แทน) — ปลอดภัยที่สุดสำหรับฐาน MyISAM ที่ rollback ไม่ได้

MYSQL_HOST=192.168.1.100
MYSQL_PORT=3306
MYSQL_USER=readonly13
MYSQL_PASSWORD=
MYSQL_DATABASE=hos

# ไม่บังคับ: secret สำหรับเซ็น session cookie (ถ้าไม่ตั้ง ระบบสร้างให้อัตโนมัติที่ data/.session-secret)
# SESSION_SECRET=
